local function getHRP()
    local char = LP.Character
    return char and char:FindFirstChild("HumanoidRootPart"), char
end

local function zombiesFolder()
    return workspace:FindFirstChild("Zombies")
end

local function zombieAlive(z)
    if not z or not z.Parent then return false end
    local cfg = z:FindFirstChild("Config")
    local hp = cfg and cfg:FindFirstChild("Health")
    local hrp = z:FindFirstChild("HumanoidRootPart")
    return hrp ~= nil and hp ~= nil and hp.Value > 0
end

local function isBoss(z)
    return CollectionService:HasTag(z, "Boss") or z:GetAttribute("Boss") == true
end

local function inSiteZone(z)
    local lock = siteLock
    if not lock then return true end
    local hrp = z:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local p, c = hrp.Position, lock.pos
    return (Vector3.new(p.X, 0, p.Z) - Vector3.new(c.X, 0, c.Z)).Magnitude <= lock.radius * 0.85
end

-- always the nearest zombie
local function pickTarget()
    local hrp = getHRP()
    local folder = zombiesFolder()
    if not hrp or not folder then return nil end

    local nearest, nearestD = nil, math.huge
    for _, z in ipairs(folder:GetChildren()) do
        if zombieAlive(z) and inSiteZone(z) then
            local d = (z.HumanoidRootPart.Position - hrp.Position).Magnitude
            if d < nearestD then nearest, nearestD = z, d end
        end
    end
    return nearest
end

local function enemyNearby(range)
    local hrp = getHRP()
    local folder = zombiesFolder()
    if not hrp or not folder then return false end
    for _, z in ipairs(folder:GetChildren()) do
        if zombieAlive(z) and (z.HumanoidRootPart.Position - hrp.Position).Magnitude <= range then
            return true
        end
    end
    return false
end

local function gateNum(gate)
    return tonumber(gate.Name:match("%d+")) or 0
end

local function remaining(gateName)
    local folder = zombiesFolder()
    local n = 0
    for _, z in ipairs(CollectionService:GetTagged(gateName .. "_Zombie")) do
        if z.Parent == folder then n += 1 end
    end
    return n
end

local function nextGate()
    local list = {}
    for _, hb in ipairs(CollectionService:GetTagged("GateHitbox")) do
        local g = hb.Parent
        if g and g.Parent and not g:GetAttribute("Opened") then
            table.insert(list, { gate = g, hb = hb })
        end
    end
    table.sort(list, function(a, b) return gateNum(a.gate) < gateNum(b.gate) end)
    return list[1]
end

local function gateReady(entry)
    local n = gateNum(entry.gate)
    for _, hb in ipairs(CollectionService:GetTagged("GateHitbox")) do
        local g = hb.Parent
        if g and g.Parent and gateNum(g) < n and remaining(g.Name) > 0 then
            return false
        end
    end
    return true
end

local function gateAllowed(entry)
    return (not state.GateWait) or gateReady(entry)
end

local function tryOpen(entry)
    local hrp = getHRP()
    if not hrp then return end
    local gate, hb = entry.gate, entry.hb

    if firetouchinterest then
        pcall(function()
            firetouchinterest(hrp, hb, 0)
            task.wait(0.05)
            firetouchinterest(hrp, hb, 1)
        end)
        task.wait(0.4)
        if gate:GetAttribute("Opened") then return end
    end

    gateBusy = true
    local back = hrp.CFrame
    hrp.CFrame = CFrame.new(hb.Position.X, hrp.Position.Y, hb.Position.Z)
    task.wait(0.5)
    if not gate:GetAttribute("Opened") then
        hrp.CFrame = back
    end
    gateBusy = false
end

