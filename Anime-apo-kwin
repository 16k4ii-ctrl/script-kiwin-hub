local PlatformUtil = { claimed = nil, claimedAt = 0 }

do
    local createRemote = Remotes and Remotes:FindFirstChild("CreateMatch")
    if createRemote then
        table.insert(conns, createRemote.OnClientEvent:Connect(function(kind, plat)
            if kind == "Create" and typeof(plat) == "Instance" then
                PlatformUtil.claimed, PlatformUtil.claimedAt = plat, os.clock()
            end
        end))
    end
end

function PlatformUtil.pick(map, mode)
    local folder = workspace:FindFirstChild("Platforms")
    if not folder then return nil end
    local best, bestScore
    for _, p in ipairs(folder:GetChildren()) do
        local cfg = p:FindFirstChild("Config")
        local taken = cfg and cfg:FindFirstChild("IsTaken")
        local hitboxes = p:FindFirstChild("Hitboxes")
        if taken and not taken.Value and hitboxes and hitboxes:FindFirstChildWhichIsA("BasePart") then
            local m, md = cfg:FindFirstChild("Map"), cfg:FindFirstChild("Mode")
            local score = ((m and m.Value == map) and 2 or 0) + ((md and md.Value == mode) and 1 or 0)
            if not best or score > bestScore then best, bestScore = p, score end
        end
    end
    return best
end

function PlatformUtil.claim(plat)
    local hrp = getHRP()
    local hitboxes = plat:FindFirstChild("Hitboxes")
    local hb = hitboxes and hitboxes:FindFirstChildWhichIsA("BasePart")
    local stand = plat:FindFirstChild("Teleport")
    if not (hrp and hb) then return nil end
    PlatformUtil.claimed = nil
    gateBusy = true
    local back = hrp.CFrame
    hrp.CFrame = hb.CFrame
    local t0 = os.clock()
    while not PlatformUtil.claimed and os.clock() - t0 < 3 do task.wait(0.05) end
    hrp = getHRP()
    if hrp then
        hrp.CFrame = stand and (stand.CFrame + Vector3.new(0, 3, 0)) or back
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    gateBusy = false
    return PlatformUtil.claimed
end

task.spawn(function()
    local lastCreate, createdUntil = 0, 0
    while alive do
        if not state.LobbyCreate then
            status.lobby = "Off"
        elseif not inLobby() then
            status.lobby = "In match"
        elseif os.clock() < createdUntil then
            status.lobby = "Match starting..."
        elseif os.clock() - lastCreate >= CREATE_COOLDOWN and Interact then
            lastCreate = os.clock()
            local mode = LobbyUtil.mode()
            local item, cost = LobbyUtil.cost(state.LMap, state.LDiff)
            local have = item and LobbyUtil.amount(item) or 0
            if item and have < cost then
                status.lobby = ("Need %d %s for %s (you have %d)"):format(cost, item, state.LMap, have)
            else
                local plat = PlatformUtil.pick(state.LMap, mode)
                if not plat then
                    status.lobby = "No free platform"
                elseif not PlatformUtil.claim(plat) then
                    status.lobby = "Platform didn't respond, retrying"
                else
                    local cfg = {
                        IsTaken = true,
                        Difficulty = state.LDiff,
                        Map = state.LMap,
                        MaxPlayers = math.min(state.LMax, (mode == "World Boss") and 8 or 6),
                        Mode = mode,
                        FriendsOnly = state.LFriends,
                    }
                    pcall(Interact.FireServer, Interact, "CreateMatch", PlatformUtil.claimed, cfg)
                    pcall(function() LP.PlayerGui.HUD.Tabs.MatchPanel.Visible = false end)
                    createdUntil = os.clock() + CREATE_WAIT
                    status.lobby = ("Created %s / %s / %s"):format(state.LMap, mode, state.LDiff)
                end
            end
        else
            status.lobby = "Waiting in lobby"
        end
        task.wait(LOBBY_RECHECK)
    end
end)

-- auto roll
task.spawn(function()
    local fails = 0
    while alive do
        if state.Roll and FuncInteract then
            RollUtil.stopped = false
            local slotType = state.RollSlot
            local key, info = RollUtil.resolveSlot(slotType)
            local want = rarityRank(state.RollStop)

            if not key then
                RollUtil.stop("No " .. slotType:lower() .. " slot found")
            elseif info.Locked then
                RollUtil.stop(key .. " is locked. Unlock it in game or pick another slot")
            else
                local have = RollUtil.rarityOfName(slotType, info.Name)
                local haveRank = have and rarityRank(have)
                if haveRank and want and haveRank >= want then
                    RollUtil.stop(("%s already has %s (%s)"):format(key, tostring(info.Name), have))
                else
                    local remoteName = (slotType == "Gadget") and "RollGadget" or "RollAbility"
                    local ok, a, b = pcall(FuncInteract.InvokeServer, FuncInteract, remoteName, key, state.RollView)
                    if ok and a == "NoSpins" then
                        RollUtil.stop(state.RollView == "Lucky" and "Out of lucky spins" or "Not enough spins or coins")
                    elseif ok and type(a) == "string" then
                        fails = 0
                        rollCount += 1
                        local rarity = (type(b) == "string" and b) or RollUtil.rarityOfName(slotType, a)
                        status.roll = ("%s rolls: %d | last: %s (%s)"):format(key, rollCount, a, tostring(rarity or "?"))
                        local got = rarity and rarityRank(rarity)
                        if got and want and got >= want then
                            RollUtil.stop(("Hit %s: %s on %s"):format(rarity, a, key))
                        end
                    else
                        fails += 1
                        status.roll = ("Roll failed (%d/5)"):format(fails)
                        if fails >= 5 then
                            RollUtil.stop("Server refused the roll 5 times (locked slot or no coins?)")
                        else
                            task.wait(0.5)
                        end
                    end
                end
            end
            task.wait(ROLL_DELAY)
        else
            fails = 0
            rollCount = 0
            if not RollUtil.stopped then
                status.roll = FuncInteract and "Off" or "Roll remote not found"
            end
            task.wait(0.5)
        end
    end
end)

