-- Auto Pickup
local function dropPosition(d)
    if d:IsA("BasePart") then return d.Position end
    if d:IsA("Model") then
        local hb = d:FindFirstChild("Hitbox")
        if hb and hb:IsA("BasePart") then return hb.Position end
        return d.PrimaryPart and d.PrimaryPart.Position
    end
    return nil
end

task.spawn(function()
    local firedAt = setmetatable({}, { __mode = "k" })
    local pending = {}
    while alive do
        if state.Pickup then
            local hrp = getHRP()
            local now = os.clock()
            if hrp then
                for _, drop in ipairs(CollectionService:GetTagged(LP.Name .. "GameDrops")) do
                    if drop.Parent and (firedAt[drop] == nil or now - firedAt[drop] > 1.5) then
                        local pos = dropPosition(drop)
                        if pos and (pos - hrp.Position).Magnitude <= PICKUP_RANGE then
                            local remote = drop:FindFirstChild("Pickup")
                            if remote and remote:IsA("RemoteEvent") then
                                firedAt[drop] = now
                                pending[drop] = true
                                pcall(remote.FireServer, remote)
                            end
                        end
                    end
                end
            end
            for drop in pairs(pending) do
                if not drop.Parent then
                    pending[drop] = nil
                    stats.Drops += 1
                end
            end
        end
        task.wait(0.15)
    end
end)

