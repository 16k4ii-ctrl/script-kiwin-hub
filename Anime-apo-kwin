ChokeUtil.NAME = "Quincy Chokehold"
ChokeUtil.RANGE = 90
ChokeUtil.ROMAN = { I = 1, II = 2, III = 3, IV = 4, V = 5, VI = 6, VII = 7, VIII = 8 }

function ChokeUtil.label(z)
    return tostring(z:GetAttribute("DisplayName") or z.Name)
end

function ChokeUtil.order(z)
    local name = ChokeUtil.label(z)
    local roman = name:match("%s(%u+)$")
    return ChokeUtil.ROMAN[roman or ""] or tonumber(name:match("%d+")) or 99
end

function ChokeUtil.flat(a, b)
    return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

function ChokeUtil.list()
    local out = {}
    local folder = zombiesFolder()
    if folder then
        for _, z in ipairs(folder:GetChildren()) do
            if z.Name == ChokeUtil.NAME and zombieAlive(z) then
                table.insert(out, z)
            end
        end
        table.sort(out, function(a, b) return ChokeUtil.order(a) < ChokeUtil.order(b) end)
    end
    return out
end

function ChokeUtil.shield(z)
    local map = workspace:FindFirstChild("Map")
    local folder = map and map:FindFirstChild("Chokeholds")
    if not folder then return nil end
    local name = z:GetAttribute("DisplayName")
    for _, p in ipairs(folder:GetChildren()) do
        if p:GetAttribute("DisplayName") == name then
            local ui = p:FindFirstChild("ChokeholdUI")
            local st = ui and ui:FindFirstChild("Status", true)
            local text = (st and st:IsA("TextLabel")) and st.Text or ""
            if text:find("^SHIELD") then
                local k, n = text:match("(%d+)%s*/%s*(%d+)")
                return true, tonumber(k) or 0, tonumber(n) or 10
            end
            return false
        end
    end
    return nil
end

function ChokeUtil.nearestEnemy(center)
    local folder = zombiesFolder()
    if not folder then return nil end
    local best, bestD = nil, math.huge
    for _, z in ipairs(folder:GetChildren()) do
        if z.Name ~= ChokeUtil.NAME and zombieAlive(z) then
            local d = ChokeUtil.flat(z.HumanoidRootPart.Position, center)
            if d <= ChokeUtil.RANGE and d < bestD then best, bestD = z, d end
        end
    end
    return best
end

