                setValue(o)
                refresh()
                saveSettings()
                if onPick then onPick(o) end
                close()
            end)
        end
    end

    row.MouseButton1Click:Connect(function()
        if list.Visible then
            close()
            return
        end
        if openDropdown then openDropdown() end
        rebuild()
        list.Visible = true
        arrow.Text = "â–´"
        openDropdown = close
    end)

    refresh()
    return { refresh = refresh, close = close }
