----------------------------------------------------------------------
-- performance mode / render off
----------------------------------------------------------------------
local perf = { on = false, saved = {}, post = {}, quality = nil, shadows = nil, conn = nil }

local function perfDisable(inst)
    if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
        or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
        if perf.saved[inst] == nil then perf.saved[inst] = inst.Enabled end
        pcall(function() inst.Enabled = false end)
    end
end

local function setPerf(on)
    if on == perf.on then return end
    perf.on = on
    if on then
        perf.saved, perf.post = {}, {}
        pcall(function()
            perf.quality = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        perf.shadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") then
                perf.post[e] = e.Enabled
                e.Enabled = false
            end
        end
        pcall(function()
            for _, d in ipairs(workspace:GetDescendants()) do perfDisable(d) end
        end)
        perf.conn = workspace.DescendantAdded:Connect(perfDisable)
    else
        if perf.conn then perf.conn:Disconnect() perf.conn = nil end
        for inst, was in pairs(perf.saved) do
            if inst.Parent then pcall(function() inst.Enabled = was end) end
        end
        for e, was in pairs(perf.post) do
            if e.Parent then pcall(function() e.Enabled = was end) end
        end
        if perf.shadows ~= nil then Lighting.GlobalShadows = perf.shadows end
        if perf.quality then
            pcall(function() settings().Rendering.QualityLevel = perf.quality end)
        end
        perf.saved, perf.post = {}, {}
    end
end

local function setRenderOff(off)
    pcall(function() RunService:Set3dRenderingEnabled(not off) end)
end

