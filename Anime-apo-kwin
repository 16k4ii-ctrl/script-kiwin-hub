    local tickCount = 0
    while alive do
        farmLabel.Text = "Farm: " .. status.farm
        gateLabel.Text = "Gate: " .. status.gate
        combatStatus.Text = status.combat
        retryStatus.Text = "Retry: " .. status.retry
