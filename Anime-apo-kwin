-- autofarm: escape > survival > go to + open the next gate > nearest zombie
local target
local gateTarget, gateArriveFor, gateArriveAt
local gateSkip = {}
local lastGateCheck = 0
local retreating, retreatStart, retreatPos = false, 0, nil

table.insert(conns, RunService.Heartbeat:Connect(function()
    if not state.Farm and not chokeTarget then
        status.farm = "Off"
        status.gate = "Off"
        target = nil
        retreating = false
        gateTarget, gateArriveFor, gateArriveAt = nil, nil, nil
        return
    end
    if gateBusy then return end
    if escapeActive then
        status.farm = "Escaping..."
        return
    end

    local hrp, char = getHRP()
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local now = os.clock()

    if state.Survival then
        local frac = hum.Health / math.max(hum.MaxHealth, 1)
        if not retreating and frac < SURVIVE_BELOW then
            retreating = true
            retreatStart = now
            retreatPos = hrp.Position + Vector3.new(0, SURVIVE_HEIGHT, 0)
            target = nil
        end
        if retreating and (frac >= SURVIVE_RESUME or now - retreatStart > SURVIVE_MAX) then
            retreating = false
        end
        if retreating then
            hrp.CFrame = CFrame.new(retreatPos)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            status.farm = ("Recovering (%d%% hp)"):format(math.floor(frac * 100))
            return
        end
    else
        retreating = false
    end

    if now - lastGateCheck > 0.3 then
        lastGateCheck = now
        gateTarget = nil
        local entry = (not siteLock and not chokeTarget) and nextGate() or nil
        if not entry then
            status.gate = (siteLock and "Holding a site") or (chokeTarget and "Chokehold mode") or "All gates open"
        elseif not entry.hb.Parent then
            status.gate = "Waiting..."
        elseif not gateAllowed(entry) then
            status.gate = entry.gate.Name .. ": clear previous zombies"
        elseif now < (gateSkip[entry.gate] or 0) then
            status.gate = entry.gate.Name .. ": skipped, retrying soon"
        else
            gateTarget = entry
            status.gate = "Opening " .. entry.gate.Name
        end
    end
    if gateTarget and (not gateTarget.gate.Parent or not gateTarget.hb.Parent or gateTarget.gate:GetAttribute("Opened")) then
        gateTarget = nil
    end

    if gateTarget then
        if gateArriveFor ~= gateTarget.gate then
            gateArriveFor, gateArriveAt = gateTarget.gate, now
        end
        if now - gateArriveAt > GATE_STAY then
            gateSkip[gateTarget.gate] = now + GATE_SKIP
            gateTarget, gateArriveFor, gateArriveAt = nil, nil, nil
        else
            hrp.CFrame = CFrame.new(gateTarget.hb.Position + GATE_OFFSET)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            status.farm = "Opening " .. gateTarget.gate.Name
            if now - (lastTry[gateTarget.gate] or 0) >= 3 then
                lastTry[gateTarget.gate] = now
                task.spawn(tryOpen, gateTarget)
            end
            return
        end
    else
        gateArriveFor, gateArriveAt = nil, nil
    end

    if ChokeUtil.mode then
        target = zombieAlive(chokeTarget) and chokeTarget or nil
    elseif not zombieAlive(target) or not inSiteZone(target) then
        target = pickTarget()
    end
    if not target then
        status.farm = siteLock and "Holding site" or (ChokeUtil.mode and "Chokehold: waiting") or "No zombies alive"
        return
    end

    local tHRP = target.HumanoidRootPart
    local tPos = tHRP.Position
    local mode, d = state.Mode, state.Dist
    local cf

    if mode == "Above" then
        cf = CFrame.lookAt(tPos + Vector3.new(0, d, 0), tPos, tHRP.CFrame.LookVector)
    elseif mode == "Below" then
        cf = CFrame.lookAt(tPos - Vector3.new(0, d, 0), tPos, tHRP.CFrame.LookVector)
    else -- Behind
        local back = tPos - tHRP.CFrame.LookVector * d
        local pos = Vector3.new(back.X, tPos.Y, back.Z)
        cf = CFrame.lookAt(pos, Vector3.new(tPos.X, pos.Y, tPos.Z))
    end

    hrp.CFrame = cf
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    status.farm = ("%s%s (%s %d)"):format(isBoss(target) and "[Boss] " or "", target.Name, mode, d)
end))

