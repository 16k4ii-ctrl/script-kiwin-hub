-- distance slider (1 to 40 studs). page scrolling is paused while dragging so touch drags move the slider
local function distanceSlider(page)
    local wrap = new("Frame", {
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = ROW,
        LayoutOrder = nextOrder(page),
    }, page)
    corner(wrap, 8)
    new("TextLabel", {
        Position = UDim2.fromOffset(12, 6),
        Size = UDim2.new(0.5, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = "Distance",
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = DIM,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, wrap)
    local distValue = new("TextLabel", {
        Position = UDim2.new(0.5, 0, 0, 6),
        Size = UDim2.new(0.5, -12, 0, 16),
        BackgroundTransparency = 1,
        Text = "",
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = TEXT,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, wrap)

    local hit = new("TextButton", {
        Position = UDim2.new(0, 12, 0, 24),
        Size = UDim2.new(1, -24, 0, 26),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, wrap)
    local track = new("Frame", {
        Position = UDim2.new(0, 0, 0.5, -3),
        Size = UDim2.new(1, 0, 0, 6),
        BackgroundColor3 = BG,
        BorderSizePixel = 0,
    }, hit)
    corner(track, 3)
    local fill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = ACCENT,
        BorderSizePixel = 0,
    }, track)
    corner(fill, 3)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(20, 20),
        BackgroundColor3 = TEXT,
    }, hit)
    corner(knob, 10)

    local function setSlider(rel)
        rel = math.clamp(rel, 0, 1)
        state.Dist = math.floor(MIN_D + rel * (MAX_D - MIN_D) + 0.5)
        local snapped = (state.Dist - MIN_D) / (MAX_D - MIN_D)
        fill.Size = UDim2.new(snapped, 0, 1, 0)
        knob.Position = UDim2.new(snapped, -10, 0.5, -10)
        distValue.Text = ("%d studs"):format(state.Dist)
    end
    setSlider((state.Dist - MIN_D) / (MAX_D - MIN_D))

    local function relFromX(x)
        return (x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1)
    end
    local sliding = false
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            page.ScrollingEnabled = false
            setSlider(relFromX(i.Position.X))
        end
    end)
    table.insert(conns, UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if sliding then saveSettings() end
            sliding = false
            page.ScrollingEnabled = true
        end
    end))
    table.insert(conns, UserInputService.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setSlider(relFromX(i.Position.X))
        end
    end))
end

