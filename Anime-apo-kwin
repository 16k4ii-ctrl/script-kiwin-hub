local function writeSettings(snapshot)
    if not writefile then return end
    pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode({ state = snapshot, stats = stats }))
    end)
end

local saveQueued = false
local function saveSettings()
    if saveQueued or not writefile then return end
    saveQueued = true
    task.delay(0.5, function()
        saveQueued = false
        if not closing then writeSettings(state) end
    end)
end
uiHooks.save = saveSettings

local function loadSettings()
    if not (isfile and readfile) then return end
    local ok, data = pcall(function()
        if isfile(SETTINGS_FILE) then
            return HttpService:JSONDecode(readfile(SETTINGS_FILE))
        end
    end)
    if not ok or type(data) ~= "table" then return end

    local s = data.state
    if type(s) == "table" then
        for k, v in pairs(state) do
            if k == "Keys" then
                if type(s.Keys) == "table" then
                    for letter in pairs(v) do
                        if type(s.Keys[letter]) == "boolean" then v[letter] = s.Keys[letter] end
                    end
                end
            elseif type(s[k]) == type(v) then
                state[k] = s[k]
            end
        end
        if type(state.Dist) ~= "number" then state.Dist = 4 end
        state.Dist = math.clamp(math.floor(state.Dist), MIN_D, MAX_D)
        if not VALID_MODES[state.Mode] then state.Mode = "Behind" end
        if not VALID_SLOT[state.RollSlot] then state.RollSlot = "Ability" end
        if not VALID_VIEW[state.RollView] then state.RollView = "Normal" end
        if not rarityRank(state.RollStop) then state.RollStop = "Legendary" end
        if state.SidePick ~= "Quincy" and state.SidePick ~= "Soul Reaper" then state.SidePick = "Quincy" end
        state.LMax = math.clamp(math.floor(state.LMax), 1, 8)
    end

    local st = data.stats
    if type(st) == "table" then
        for k in pairs(stats) do
            if type(st[k]) == "number" then stats[k] = st[k] end
        end
    end
end
loadSettings()
