        sitesStatus.Text = "Sites: " .. status.sites
        chokeStatus.Text = "Chokeholds: " .. status.choke
        lobbyStatus.Text = "Create: " .. status.lobby
        rollStatus.Text = "Roll: " .. status.roll

        statRows.Runtime.Text = fmtTime(stats.Runtime)
        statRows.Kills.Text = tostring(stats.Kills)
        statRows.Matches.Text = tostring(stats.Matches)
        statRows.Gates.Text = tostring(stats.Gates)
        statRows.Drops.Text = tostring(stats.Drops)

        if tickCount % 2 == 0 then
            local data = LP:FindFirstChild("Data")
            local pre = (state.RollSlot == "Gadget") and "Gadget" or "Ability"
            local nv = data and data:FindFirstChild("Normal" .. pre .. "Spins")
            local lv = data and data:FindFirstChild("Lucky" .. pre .. "Spins")
            local cv = data and data:FindFirstChild("Coins")
            spinsLabel.Text = ("Spins - Normal: %s | Lucky: %s | Coins: %s"):format(
                nv and tostring(nv.Value) or "?", lv and tostring(lv.Value) or "?", cv and tostring(cv.Value) or "?")
            slotDD.refresh()
        end
        tickCount += 1

        local now = os.clock()
        for _, letter in ipairs(KEYS) do
            local left = (cdEnd[letter] or 0) - now
            chips[letter].Text = (left > 0.05) and ("%s %ds"):format(letter, math.ceil(left)) or letter
        end

        local _, gname = findSlot("GadgetSlots", "Equipped")
        local meter = LP:FindFirstChild("GadgetMeter")
        local req = gname and gadgetRequirement(gname)
        if gname and meter and req then
            local value = math.min(meter.Value, req)
            gName.Text = gname
            gValue.Text = ("%d / %d"):format(math.floor(value), req)
            gFill.Size = UDim2.new(math.clamp(value / req, 0, 1), 0, 1, 0)
            gFill.BackgroundColor3 = (meter.Value >= req) and GREEN or ACCENT
        else
            gName.Text = gname or "No gadget equipped"
            gValue.Text = ""
            gFill.Size = UDim2.new(0, 0, 1, 0)
        end

        task.wait(0.25)
    end
end)

