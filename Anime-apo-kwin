local VALID_MODES = { Above = true, Behind = true, Below = true }
local VALID_SLOT = { Ability = true, Gadget = true }
local VALID_VIEW = { Normal = true, Lucky = true }

local function rarityRank(name)
    local r = RollModule and RollModule.RarityRank and RollModule.RarityRank[name]
    if type(r) == "number" then return r end
    for i, n in ipairs(FALLBACK_RARITIES.Ability) do
        if n == name then return i end
    end
    return nil
end

local RollUtil = {}

function RollUtil.rarityList(slotType)
    local key = (slotType == "Gadget") and "Gadgets" or "Abilities"
    local src = RollModule and RollModule.Rarities and RollModule.Rarities[key]
    local list = {}
    if type(src) == "table" and RollModule.RarityRank then
        for name in pairs(src) do
            if RollModule.RarityRank[name] then table.insert(list, name) end
        end
        table.sort(list, function(a, b) return RollModule.RarityRank[a] < RollModule.RarityRank[b] end)
    end
    if #list == 0 then
        list = FALLBACK_RARITIES[(slotType == "Gadget") and "Gadget" or "Ability"]
    end
    return list
end

function RollUtil.fixChoice()
    local list = RollUtil.rarityList(state.RollSlot)
    for _, r in ipairs(list) do
        if r == state.RollStop then return end
    end
    local top = list[#list]
    local old, topRank = rarityRank(state.RollStop), top and rarityRank(top)
    if old and topRank and old > topRank then
        state.RollStop = top
    else
        state.RollStop = "Legendary"
    end
end

function RollUtil.slots(slotType)
    local data = LP:FindFirstChild("Data")
    local v = data and data:FindFirstChild((slotType == "Gadget") and "GadgetSlots" or "AbilitySlots")
    if not v then return nil end
    local ok, t = pcall(HttpService.JSONDecode, HttpService, v.Value)
    if ok and type(t) == "table" then return t end
    return nil
end

function RollUtil.slotKeys(slotType)
    local t = RollUtil.slots(slotType)
    local keys = {}
    if t then
        for k in pairs(t) do table.insert(keys, k) end
        table.sort(keys, function(a, b)
            return (tonumber(tostring(a):match("%d+")) or 0) < (tonumber(tostring(b):match("%d+")) or 0)
        end)
    end
    return keys
end

function RollUtil.slotLabel(slotType, key)
    local t = RollUtil.slots(slotType)
    local info = t and t[key]
    if type(info) ~= "table" then return tostring(key) end
    return ("%s: %s%s"):format(tostring(key), tostring(info.Name or "?"), info.Locked and " (locked)" or "")
end

function RollUtil.resolveSlot(slotType)
    local t = RollUtil.slots(slotType)
    if not t then return nil end
    local picked = (slotType == "Gadget") and state.RollGadgetSlot or state.RollAbilitySlot
    if picked ~= "" and type(t[picked]) == "table" then return picked, t[picked] end
    local keys = RollUtil.slotKeys(slotType)
    for _, k in ipairs(keys) do
        if type(t[k]) == "table" and not t[k].Locked then return k, t[k] end
    end
    if keys[1] and type(t[keys[1]]) == "table" then return keys[1], t[keys[1]] end
    return nil
end

function RollUtil.rarityOfName(slotType, name)
    local key = (slotType == "Gadget") and "Gadgets" or "Abilities"
    local src = RollModule and RollModule.Rarities and RollModule.Rarities[key]
    if type(src) ~= "table" then return nil end
    for rarity, list in pairs(src) do
        if type(list) == "table" and table.find(list, name) then return rarity end
    end
    return nil
end

function RollUtil.stop(reason)
    state.Roll = false
    RollUtil.stopped = true
    status.roll = reason
    if uiHooks.refreshToggle then uiHooks.refreshToggle("Roll") end
    if uiHooks.save then uiHooks.save() end
end

