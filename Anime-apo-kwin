        end)
    end
    return list
end

function SiteUtil.standCF(site)
    local _, char = getHRP()
    local ignore = { site.Parent }
    if char then table.insert(ignore, char) end
    for _, n in ipairs({ "Alive", "Zombies", "Thrown" }) do
        local f = workspace:FindFirstChild(n)
        if f then table.insert(ignore, f) end
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then table.insert(ignore, pl.Character) end
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore
    local pos = site.Position
    local hit = workspace:Raycast(pos + Vector3.new(0, 40, 0), Vector3.new(0, -90, 0), params)
    local floorY = hit and hit.Position.Y or (pos.Y - site.Size.X / 2)
    return CFrame.new(pos.X, floorY + 3, pos.Z)
end

