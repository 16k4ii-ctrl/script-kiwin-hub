local policeFollow = false
local policeBringDist = 8
local espPoliceEnabled = false
local autoAmmoEnabled = false

local function getPoliceList()
    local list = {}
    local f = workspace:FindFirstChild("Police")
    if f then
        for _, m in ipairs(f:GetChildren()) do
            if m:IsA("Model") then
                table.insert(list, m)
            end
        end
    end
    return list
end

local function getRootPart()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

local function placePolice(dest, facePos)
    for _, m in ipairs(getPoliceList()) do
        local hum = m:FindFirstChildOfClass("Humanoid")
        local hrp = m:FindFirstChild("HumanoidRootPart")
        if hum and hrp and hum.Health > 0 then
            pcall(function()
                hrp.CFrame = dest
                hrp.Anchored = true
                hrp.CFrame = CFrame.new(hrp.Position, facePos)
            end)
        end
    end
end

local function bringPolice()
    local root = getRootPart()
    if not root then return end
    placePolice(root.CFrame * CFrame.new(0, 0, -policeBringDist), root.Position)
end

local function releasePolice()
    for _, m in ipairs(getPoliceList()) do
        local hrp = m:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function() hrp.Anchored = false end)
        end
    end
end

-- follow loop
task.spawn(function()
    while gui.Parent do
        if policeFollow then
            local root = getRootPart()
            if root then
                placePolice(root.CFrame * CFrame.new(0, 0, -policeBringDist), root.Position)
            end
        end
        task.wait(0.1)
    end
end)

