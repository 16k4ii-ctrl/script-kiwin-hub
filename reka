local SETTINGS_FILE = "KIWIN_HUB_Settings.json"

local SettingsData = { version = 1, toggles = {}, sliders = {} }
local SettingControls = { toggles = {}, sliders = {} }

local function normalizeSettings(data)
    if type(data) ~= "table" then data = {} end
    if type(data.toggles) ~= "table" then data.toggles = {} end
    if type(data.sliders) ~= "table" then data.sliders = {} end
    data.version = 1
    return data
end

local function loadSavedSettings()
    local loaded = nil

    pcall(function()
        if type(readfile) == "function" then
            local raw = readfile(SETTINGS_FILE)
            if raw and raw ~= "" then
                loaded = HttpService:JSONDecode(raw)
            end
        end
    end)

    if type(loaded) ~= "table" then
        pcall(function()
            if type(getgenv) == "function" then
                local env = getgenv()
                if type(env.KIWIN_HUB_SETTINGS) == "table" then
                    loaded = env.KIWIN_HUB_SETTINGS
                end
            end
        end)
    end

    return normalizeSettings(loaded)
end

local function saveSettingsData(data)
    data = normalizeSettings(data)
    SettingsData = data

    pcall(function()
        if type(writefile) == "function" then
            writefile(SETTINGS_FILE, HttpService:JSONEncode(data))
        end
    end)

    pcall(function()
        if type(getgenv) == "function" then
            getgenv().KIWIN_HUB_SETTINGS = data
        end
    end)
end

local function saveCurrentSettings()
    local data = { version = 1, toggles = {}, sliders = {} }

    for key, control in pairs(SettingControls.toggles) do
        pcall(function() data.toggles[key] = control.get() end)
    end

    for key, control in pairs(SettingControls.sliders) do
        pcall(function() data.sliders[key] = control.get() end)
    end

    saveSettingsData(data)
    return data
end

local function clearSavedSettings()
    SettingsData = { version = 1, toggles = {}, sliders = {} }

    pcall(function()
        if type(delfile) == "function" then
            delfile(SETTINGS_FILE)
        end
    end)

    pcall(function()
        if type(getgenv) == "function" then
            getgenv().KIWIN_HUB_SETTINGS = nil
        end
    end)
end

