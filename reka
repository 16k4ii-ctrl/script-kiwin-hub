-- interaction remotes (used by auto collect ammo)
local function findRemoteAny(name)
    local pkg = ReplicatedStorage:FindFirstChild("RS_Package")
    if pkg then
        local r = pkg:FindFirstChild(name, true)
        if r and r:IsA("RemoteEvent") then return r end
    end
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") and v.Name == name then return v end
    end
end

local startInteract = findRemoteAny("StartInteraction")
local completeInteract = findRemoteAny("CompleteInteraction")

task.spawn(function()
    for _ = 1, 12 do
        if startInteract and completeInteract then break end
        task.wait(5)
        startInteract = startInteract or findRemoteAny("StartInteraction")
        completeInteract = completeInteract or findRemoteAny("CompleteInteraction")
    end
end)

-- auto collect ammo
local function isAmmoName(n)
    n = string.lower(tostring(n))
    return n:find("ammo", 1, true) ~= nil
end

local function collectAmmoPass()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local objects = {}

    for _, fname in ipairs({ "AmmoPickups", "AmmoDrops", "AmmoBoxes", "Ammo" }) do
        local f = workspace:FindFirstChild(fname) or workspace:FindFirstChild(fname, true)
        if f then
            table.insert(objects, f)
        end
    end

    if #objects == 0 then
        for _, d in ipairs(workspace:GetDescendants()) do
            if (d:IsA("BasePart") or d:IsA("Model")) and isAmmoName(d.Name) and not d:IsDescendantOf(char) then
                table.insert(objects, d)
            end
        end
    end

    for _, obj in ipairs(objects) do
        local parts = {}

        if obj:IsA("BasePart") then
            table.insert(parts, obj)
        else
            for _, d in ipairs(obj:GetDescendants()) do
                if d:IsA("BasePart") then
                    table.insert(parts, d)
                end
            end
            if #parts == 0 and obj:IsA("Model") and obj.PrimaryPart then
                table.insert(parts, obj.PrimaryPart)
            end
        end

        if type(firetouchinterest) == "function" then
            for _, part in ipairs(parts) do
                pcall(function()
                    firetouchinterest(part, hrp, 0)
                    firetouchinterest(part, hrp, 1)
                end)
            end
        end

        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("ProximityPrompt") and startInteract and completeInteract then
                pcall(function()
                    startInteract:FireServer(d)
                    completeInteract:FireServer(d)
                end)
            end
        end
    end
end

task.spawn(function()
    while gui.Parent do
        if autoAmmoEnabled then
            pcall(collectAmmoPass)
        end
        task.wait(1)
    end
end)

-- break glass / cameras
local function getHitRemote()
    local pkg = ReplicatedStorage:FindFirstChild("RS_Package")
    local assets = pkg and pkg:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild("HitObject")
end

local function fireHit(part)
    local char = player.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool or not part or not part:IsA("BasePart") then return end

    local remote = getHitRemote()
    if not remote then return end

    pcall(function()
        remote:FireServer(tool, part, false, nil, nil, Vector3.new(0, 0, 0), 999999999, nil, part.Position)
    end)
end

local function fireParts(parts)
    if #parts == 0 then return end

    task.spawn(function()
        local c = 0
        for _, p in ipairs(parts) do
            fireHit(p)
            c = c + 1
            if c % 20 == 0 then
                task.wait(0.05)
            end
        end
    end)
end

local function collectPartsMatching(words)
    local parts = {}
    local seen = {}

    local function add(p)
        if p:IsA("BasePart") and not seen[p] then
            seen[p] = true
            table.insert(parts, p)
        end
    end

    for _, w in ipairs(words) do
        local cap = string.upper(w:sub(1, 1)) .. w:sub(2)
        local f = workspace:FindFirstChild(cap) or workspace:FindFirstChild(cap, true)
        if f then
            if f:IsA("BasePart") then
                add(f)
            else
                for _, d in ipairs(f:GetDescendants()) do
                    add(d)
                end
            end
        end
    end

    if #parts == 0 then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("BasePart") then
                local n = string.lower(d.Name)
                for _, w in ipairs(words) do
                    if n:find(w, 1, true) then
                        add(d)
                        break
                    end
                end
            end
        end
    end

    return parts
end

local function breakAllGlass()
    fireParts(collectPartsMatching({ "glass" }))
end

local function breakAllWindows()
    fireParts(collectPartsMatching({ "window" }))
end

local function breakAllCameras()
    task.spawn(function()
        for _, fn in ipairs({ "Cameras", "BrokenCameras" }) do
            local f = workspace:FindFirstChild(fn)
            if f then
                for _, cam in ipairs(f:GetChildren()) do
                    local p
                    if cam:IsA("BasePart") then
                        p = cam
                    else
                        p = cam:FindFirstChild("Hinge")
                            or cam:FindFirstChild("Union")
                            or cam:FindFirstChild("Head")
                            or cam:FindFirstChildWhichIsA("MeshPart", true)
                            or cam:FindFirstChildWhichIsA("BasePart", true)
                    end
                    if p then
                        fireHit(p)
                    end
                end
            end
        end
    end)
end

